# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Pick My Ball – Astoria Regency)
# Populate these values from your standalone Pick My Ball Supabase project.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser code (no VITE_ prefix).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional disposable local/test database for integration & concurrency tests
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Optional Edge Functions base URL override (defaults to ${VITE_SUPABASE_URL}/functions/v1)
VITE_EDGE_FUNCTIONS_URL=

# Comma-separated allowed browser origins for Supabase Edge Functions CORS
# Example: https://pickmyball.pages.dev,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Public API rate-limit settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=40

